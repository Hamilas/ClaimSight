# ClaimSight-Analytics — Environment Variables
# Copy this file to .env and fill in values before running
# cp .env.example .env

# ─── Pipeline Configuration ───────────────────────────────────────────────────

# Which pipeline layer to execute: bronze | silver | gold | all
PIPELINE_LAYER=all

# Path to pipeline configuration YAML (relative to repo root)
PIPELINE_CONFIG=conf/pipeline.yml

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Spark Configuration ──────────────────────────────────────────────────────

# Spark local IP binding (set to 127.0.0.1 for local/Docker runs)
SPARK_LOCAL_IP=127.0.0.1

# ─── Data Quality ─────────────────────────────────────────────────────────────

# Enable Great Expectations quality gates (true | false)
DATA_QUALITY_ENABLED=true

# Fail pipeline on quality check failure (true | false)
DATA_QUALITY_FAIL_ON_ERROR=true

# Directory for quality validation JSON reports
DATA_QUALITY_RESULTS_PATH=data/system/quality

# ─── Storage Paths ────────────────────────────────────────────────────────────

# Raw input data directory
RAW_DATA_PATH=data/raw

# Bronze (ingested) layer output
BRONZE_PATH=data/bronze

# Silver (transformed) layer output
SILVER_PATH=data/silver

# Gold (aggregated) layer output
GOLD_PATH=data/gold

# Incremental run metadata directory
METADATA_PATH=data/system

# ─── Pipeline Metrics ─────────────────────────────────────────────────────────

# Directory for pipeline run metrics JSON logs
METRICS_OUTPUT_PATH=data/system/metrics
